generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Production target: PostgreSQL. JSON FileStore mirrors only the low-volume
// config, user, and alarm entities for development. Raw sensor history requires
// PostgreSQL. Relations: Station 1->N Sensor 1->1 configs, 1->N events.

model Station {
  id        String   @id @default("000000")
  lastSeen  DateTime?
  sensors   Sensor[]
}

model Sensor {
  id        String   @id // "02"
  stationId String   @default("000000")
  station   Station  @relation(fields: [stationId], references: [id])
  name      String
  type      String
  fieldMap  Json
  config    SensorConfiguration?
  alarm     AlarmConfiguration?
  events    AlarmEvent[]
}

model SensorConfiguration {
  id       Int    @id @default(autoincrement())
  sensorId String @unique
  sensor   Sensor @relation(fields: [sensorId], references: [id])
  updatedAt DateTime @updatedAt
}

model AlarmConfiguration {
  id        Int      @id @default(autoincrement())
  sensorId  String   @unique
  sensor    Sensor   @relation(fields: [sensorId], references: [id])
  thresholds Json
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(cuid())
  username String @unique
  hash     String
  role     String @default("VIEWER")
}

model AlarmEvent {
  id         String   @id @default(cuid())
  stationId  String
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id])
  kind       String
  lifecycle  String
  value      Float?
  threshold  Float?
  startedAt  DateTime
  recoveredAt DateTime?
  lastNotifiedAt DateTime?
  message    String

  @@index([sensorId, startedAt])
}

model NotificationLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  type     String
  sensorId String
  kind     String
}

model AppSettings {
  id                 String   @id @default("default")
  notificationEmails Json     @default("[]")
  updatedAt          DateTime @updatedAt
}

// Raw telemetry is separate from sensor inventory and alarms. Production
// creates this as a PostgreSQL RANGE partitioned table by receivedAt.
model SensorReading {
  receivedAt    DateTime @db.Timestamptz(3)
  packetId      String   @db.Uuid
  stationId     String
  sensorId      String
  deviceTimeRaw String?
  temperature   Float?
  temperature2  Float?
  humidity      Float?
  secondary     Float?
  battery       Float?
  rawStatus     String?
  rawFields     Json

  @@id([receivedAt, packetId, sensorId])
  @@index([sensorId, receivedAt])
  @@map("sensor_readings")
}

model SensorArchiveDay {
  day         DateTime @id @db.Date
  objects     Json
  rowCount    BigInt
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("sensor_archive_days")
}

model SensorExportJob {
  id          String   @id @default(uuid()) @db.Uuid
  requestedBy String
  sensorIds   Json
  from        DateTime @db.Timestamptz(3)
  to          DateTime @db.Timestamptz(3)
  status      String   @default("PENDING")
  objectKey   String?
  rowCount    BigInt?
  error       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([requestedBy, createdAt])
  @@map("sensor_export_jobs")
}
