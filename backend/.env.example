# G7 network listener (Node LISTENs, Base Station connects)
G7_HOST=0.0.0.0
G7_PORT=6900
# Max sizes (DoS protection)
G7_MAX_MESSAGE_BYTES=65536
G7_MAX_BUFFER_BYTES=1048576

# HTTP API + WebSocket
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Production frontend origin. Add localhost after a comma only when local development needs it.
FRONTEND_ORIGIN=https://monitoring.prideengs.com

# Alarm engine
ALARM_DELAY_SECONDS=300
ALARM_REPEAT_MINUTES=30
SENSOR_TIMEOUT_SECONDS=120
RECOVERY_EMAIL_ENABLED=true

# Email (Brevo SMTP via Nodemailer). EMAIL_ENABLED=false logs only.
EMAIL_ENABLED=false
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@example.com
ALERT_FROM_NAME=Pride Monitoring

# Auth
JWT_SECRET=change-me-dev-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# Persistence (Supabase transaction pool for the app; session pool for migrations).
# Replace [YOUR-PASSWORD] with a URL-encoded password.
DATABASE_URL="postgresql://postgres.kjprsfupezjenmpywggz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.kjprsfupezjenmpywggz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DATA_DIR=./data

# Private Oracle Object Storage bucket via its S3 compatibility API.
# Capture in PostgreSQL works without these; archive and CSV jobs need all five.
OCI_OBJECT_NAMESPACE=
OCI_OBJECT_REGION=
OCI_OBJECT_BUCKET=
OCI_OBJECT_ACCESS_KEY=
OCI_OBJECT_SECRET_KEY=
SENSOR_HOT_DAYS=90
# DATA_DIR must be on persistent disk. Frames waiting for PostgreSQL are fsynced here.
SENSOR_SPOOL_MAX_MB=512
# Completed CSV files are removed from Oracle Object Storage after this many days.
SENSOR_EXPORT_TTL_DAYS=7

LOG_LEVEL=info
NODE_ENV=development
